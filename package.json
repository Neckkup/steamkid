{
  "name": "steamkid",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:smoke": "tsx --env-file-if-exists=.env.local scripts/ai-smoke.ts",
    "langfuse:verify": "tsx --env-file-if-exists=.env.local scripts/langfuse-verify.ts",
    "langfuse:prompts": "tsx --env-file-if-exists=.env.local scripts/langfuse-sync-prompts.ts",
    "langfuse:dashboards": "tsx --env-file-if-exists=.env.local scripts/langfuse-sync-dashboards.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "browser:setup": "bash scripts/setup-browser.sh",
    "browser:check": "bash scripts/setup-browser.sh --check",
    "visual:audit": "bash -c 'eval \"$(bash scripts/setup-browser.sh)\" && tsx scripts/visual-audit.ts \"$@\"' --"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^2.23.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.75.0",
    "langfuse": "^3.39.2",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "playwright": "^1.62.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.11"
  }
}
