  id                  String   @id @db.Uuid
  spec_version        String
  dataset_kind        String
  filters             Json
  consent_snapshot_at DateTime @db.Timestamptz(6)
  row_count           Int
  output_uri          String
  checksum            String
  redaction_version   String
  created_by_user_id  String?  @db.Uuid
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@schema("ml")
}
