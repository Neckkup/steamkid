// steamkid data model.
//
// ⚠️ THIS FILE IS NOT THE SCHEMA. Read `prisma/migrations/` instead.
//
// data-schema §7 rule 3 makes DDL SQL-first: the migrations in
// `prisma/migrations/*/migration.sql` are the source of truth, and this file is
// an artifact that `prisma db pull` re-syncs from a live database. No database
// has been provisioned yet (PRO-68, PRO-70), so it has never been pulled and
// shows two models out of roughly twenty tables.
//
// What the migrations already contain and this file does not: the four schemas
// (`identity` / `app` / `events` / `ml`), the partitioned behaviour pipe, the
// content and attempt tables, `app.ai_verdict` and `app.ai_verdict_criterion`,
// `app.teacher_correction`, and the consent-gated `ml` export views.
//
// Reading this file as "what exists" has already cost one ticket's premise
// (PRO-76 was written believing there was no verdict table). Re-pull it the day
// a database exists; until then, `prisma/migrations/` is the answer.
//
// The two constraints below are the ones expensive to retrofit, kept here
// because the generated client leans on them:
//
//   1. A pseudonymous `Learner.id` surrogate key. Nothing outside our
//      infrastructure ever sees anything else for a child.
//   2. A consent record that is required before any behaviour event is stored.
//
// Event tables are append-only with a versioned payload; never mutate history
// in place, add a new row and a new `payloadVersion` instead.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 moved connection URLs out of the schema: the CLI reads them from
// `prisma.config.ts`, and the runtime client gets an explicit driver adapter
// (see `src/lib/db.ts`).
datasource db {
  provider = "postgresql"
}

/// A child, referenced externally only by this pseudonymous id.
/// Identifying fields (name, birth date, guardian contact) are added in PRO-7
/// and must never be joined into an export or an external trace.
model Learner {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  consents  ConsentRecord[]

  @@map("learners")
}

/// Parental/guardian consent. Absence of an active record means we collect
/// nothing beyond what is required to run the session.
model ConsentRecord {
  id            String    @id @default(cuid())
  learnerId     String    @map("learner_id")
  learner       Learner   @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  /// e.g. behaviour_analytics, ai_grading, training_data_export
  scope         String
  granted       Boolean
  /// Version of the privacy notice the guardian actually saw.
  policyVersion String    @map("policy_version")
  grantedAt     DateTime  @default(now()) @map("granted_at")
  revokedAt     DateTime? @map("revoked_at")

  @@index([learnerId, scope])
  @@map("consent_records")
}
